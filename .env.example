# انسخ هذا الملف وسميه .env وحط بياناتك
# API_ID و API_HASH من https://my.telegram.org/apps
API_ID=12345678
API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# نسخة الاستضافة: الجلسة النصية من get_session.py (مهمة — بدونها ما بيشتغل على Render)
# نسخة الجهاز: اتركها فاضية وبيستخدم ملف subaru.session
SESSION_STRING=
SESSION_NAME=subaru
# توكن البوت من @BotFather (اختياري — بدونه اليوزربوت يشتغل عادي)
BOT_TOKEN=123456789:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# القناة الرئيسية للسورس (بينضم لها تلقائياً عند التشغيل)
MAIN_CHANNEL=https://t.me/subaru_surce
TRANSFER_DELAY=10
DEFAULT_LIMIT=20
MAX_LIMIT=50
DAILY_TRANSFER_LIMIT=100
SAFE_MODE=true
